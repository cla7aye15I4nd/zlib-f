+
     /* for small len, copy to input buffer, otherwise compress directly */
     if (len < state->size) {
         /* copy to input buffer, compress when full */
@@ -346,7 +352,7 @@ int ZEXPORT gzputc(gzFile file, int c) {
         if (strm->avail_in == 0)
