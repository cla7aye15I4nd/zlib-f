theorem certificate_dist (ll fl dl fd : Nat → Nat) (H Δ : Nat) (small : Δ ≤ 138)
    (lenL : ∀ v, v < 286 → ll v ≤ 15) (lenD : ∀ v, v < 30 → dl v ≤ 15)
