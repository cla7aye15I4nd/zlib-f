    (usedD : ∀ v, v < 30 → fd v ≠ 0 → 1 ≤ dl v ∧ fd v * fib (dl v + 1) + fib (dl v) ≤ 130)
    (dummyL : ∀ v, v < 286 → ll v ≠ 0 → fl v = 0 → False)
    (dummyD : ∀ v, v < 30 → dl v ≠ 0 → fd v = 0 → v ≤ 2)
    (twoD : mass (fun v => isUsed (dl v)) 30 ≤ 2)
    (eob : fl 256 = 1)
    (symbols : mass (fun v => if v = 256 then 0 else fl v) 286 ≤ 127)
    (balance : mass (fun v => if v < 257 then 0 else fl v) 286 = mass fd 30)
    (header : 2 * H ≤ 2 * (71 + Δ) + mass (fun v => literalCharge v (ll v)) 286 +
