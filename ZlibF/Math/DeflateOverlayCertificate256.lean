theorem entry_none_LIT8 (x f d r : Nat) (hx : x ≤ 15)
    (used : f ≠ 0 → 1 ≤ x ∧ f * fib (x + 1) + fib x ≤ 258)
    (dummy : x ≠ 0 → f ≠ 0) (zero : d = 0)
    (count : r = 0 * isUsed x) :
    10387456 * literalRegionCharge x + 12779520 * (f * 8) ≤
      49917 * kraftTerm x + 20774912 + d + f * 137428992 + 12779520 * (f * x) + r := by
  obtain ⟨f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16, _⟩ := fib_values
  subst count
  simp only [isUsed]
  by_cases hf : f = 0
  · subst hf
    by_cases x0 : x = 0
    · subst x0 zero
      simp only [literalRegionCharge, otherRegionCharge, kraftTerm, reduceIte, Nat.reduceEqDiff, Nat.reduceAdd, Nat.reduceSub, Nat.reducePow, Nat.reduceMul, f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16]; omega
    · exact absurd rfl (dummy x0)
  · obtain ⟨pos, fit⟩ := used hf
