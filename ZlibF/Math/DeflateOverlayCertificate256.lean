import ZlibF.Math.DeflateOverlayCertificate

/-!
# The memLevel 2 overlay certificate (`lit_bufsize = 256`)

Generated by `tests/goals/overlay-adversarial/certificate/overlay_cert_choice.py --size 256 --lean`; do not edit.
The test `certificate/regenerate.sh` regenerates it and compares.

For the lengths `ll`, `dl`, the actual frequencies `fl`, `fd` and the header length `H` of a
dynamic block with at most 255 symbols, `H + E ≤ 2023`, from the header row (the region charges of
the scan under the reference code `κ0`, plus the repair excess `Δ`), the choice row, Kraft, the
Fibonacci bound (weight 258), the end of block, the symbol count and the balance. Three cases:
no forced leaf (`certificate_none`); forced leaves only in the distance tree, which then has two
nonzero lengths (`certificate_dist`); forced leaves in the literal/length tree, which then has two
nonzero lengths (`certificate_lit`). Each class of entries is a sixteen-case `omega` check.
-/

namespace ZlibF.Math.DeflateOverlayCertificate256
open ZlibF.Math.DeflateSymbols
open Zlib.Trees.HuffmanAbstract (fib)
open ZlibF.Math.DeflateOverlaySmall (fib_values)
open ZlibF.Math.DeflateOverlayCertificate (kraftTerm lengthExtra distanceExtra literalExcess distanceExcess
  mass_split mass_const lengthExtra_le distanceExtra_le)
set_option autoImplicit false

/-- The reference bit-length code `κ0` (symbols 0..18). -/
def refLen0 : Nat → Nat
  | 0 => 2
  | 1 => 7
  | 2 => 7
  | 3 => 5
  | 4 => 5
  | 5 => 4
  | 6 => 4
  | 7 => 4
  | 8 => 4
  | 9 => 3
  | 10 => 4
  | 11 => 4
  | 12 => 7
  | 13 => 7
  | 14 => 7
  | 15 => 7
  | 16 => 7
  | 17 => 3
  | 18 => 7
  | _ => 0

/-- The region charge of an entry of length `x` in the literal region (positions 0..256),
scaled by 2: 2 for a zero, `2·max(κ0[x], 3) + 6` for a length. -/
def literalRegionCharge : Nat → Nat
  | 0 => 2
  | 1 => 20
  | 2 => 20
  | 3 => 16
  | 4 => 16
  | 5 => 14
  | 6 => 14
  | 7 => 14
  | 8 => 14
  | 9 => 12
  | 10 => 14
  | 11 => 14
  | 12 => 20
  | 13 => 20
  | 14 => 20
  | 15 => 20
  | _ => 0

/-- The region charge of an entry in the length or distance region, scaled by 2: 4 for a zero,
`2·max(κ0[x], 3)` for a length. -/
def otherRegionCharge : Nat → Nat
  | 0 => 4
  | 1 => 14
  | 2 => 14
  | 3 => 10
  | 4 => 10
  | 5 => 8
  | 6 => 8
  | 7 => 8
  | 8 => 8
  | 9 => 6
  | 10 => 8
  | 11 => 8
  | 12 => 14
  | 13 => 14
  | 14 => 14
  | 15 => 14
  | _ => 0

/-- The region charge of literal/length entry `v` at length `x`. -/
def literalCharge (v x : Nat) : Nat := if v ≤ 256 then literalRegionCharge x else otherRegionCharge x

/-- The fixed code length of literal/length symbol `v`. -/
def staticLen (v : Nat) : Nat := if v < 144 then 8 else if v < 256 then 9 else if v < 280 then 7 else 8

/-- One for a nonzero length. -/
def isUsed (x : Nat) : Nat := if x = 0 then 0 else 1

