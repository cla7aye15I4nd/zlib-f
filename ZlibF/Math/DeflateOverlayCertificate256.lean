/-- **The memLevel 1 certificate, case `none`**: with `Δ ≤ 640`. -/
theorem certificate_none (ll fl dl fd : Nat → Nat) (H Δ : Nat) (small : Δ ≤ 640)
    (lenL : ∀ v, v < 286 → ll v ≤ 15) (lenD : ∀ v, v < 30 → dl v ≤ 15)
    (kraftL : mass (fun v => kraftTerm (ll v)) 286 ≤ 2 ^ 15)
    (kraftD : mass (fun v => kraftTerm (dl v)) 30 ≤ 2 ^ 15)
    (usedL : ∀ v, v < 286 → fl v ≠ 0 → 1 ≤ ll v ∧ fl v * fib (ll v + 1) + fib (ll v) ≤ 258)
    (usedD : ∀ v, v < 30 → fd v ≠ 0 → 1 ≤ dl v ∧ fd v * fib (dl v + 1) + fib (dl v) ≤ 258)
    (dummyL : ∀ v, v < 286 → ll v ≠ 0 → fl v = 0 → False)
    (dummyD : ∀ v, v < 30 → dl v ≠ 0 → fd v = 0 → False)
    (eob : fl 256 = 1)
    (symbols : mass (fun v => if v = 256 then 0 else fl v) 286 ≤ 255)
    (balance : mass (fun v => if v < 257 then 0 else fl v) 286 = mass fd 30)
    (header : 2 * H ≤ 2 * (71 + Δ) + mass (fun v => literalCharge v (ll v)) 286 +
      mass (fun v => otherRegionCharge (dl v)) 30)
    (choice : H + mass (fun v => fl v * ll v) 286 + mass (fun v => fd v * dl v) 30 + 1 ≤
      mass (fun v => fl v * staticLen v) 286 + 5 * mass fd 30) :
    H + mass (fun v => fl v * literalExcess v (ll v)) 286 +
      mass (fun v => fd v * distanceExcess v (dl v)) 30 ≤ 2023 := by
  have sumL : mass (fun v => 10387456 * literalCharge v (ll v) + 12779520 * (fl v * staticLen v) +
      33554432 * (fl v * literalExcess v (ll v))) 286 ≤
      mass (fun v => 49917 * kraftTerm (ll v) + literalAllow_none v + fl v * literalRate_none v +
        12779520 * (fl v * ll v) + 0 * isUsed (ll v)) 286 :=
    mass_mono fun v hv => literal_entry_none ll fl v hv (lenL v hv) (usedL v hv) (dummyL v hv) eob
  have sumD : mass (fun v => 10387456 * otherRegionCharge (dl v) + 12779520 * (fd v * 5) +
      33554432 * (fd v * distanceExcess v (dl v))) 30 ≤
      mass (fun v => 11887 * kraftTerm (dl v) + distanceAllow_none v + fd v * 50757632 +
        12779520 * (fd v * dl v) + 0 * isUsed (dl v)) 30 :=
    mass_mono fun v hv => distance_entry_none dl fd v hv (lenD v hv) (usedD v hv) (dummyD v hv)
  simp only [mass_add, mass_mul_left, mass_mul_right] at sumL sumD
  have rates : mass (fun v => fl v * literalRate_none v) 286 =
      137428992 * mass (fun v => if v < 256 then fl v else 0) 286 +
        86671360 * mass (fun v => if v < 257 then 0 else fl v) 286 := by
    rw [← mass_mul_left, ← mass_mul_left, ← mass_add]
    apply mass_congr
    intro v _
    simp only [literalRate_none]
    by_cases a : v < 256
    · simp [a, show v < 257 by omega, Nat.mul_comm]
    · by_cases b : v = 256
      · subst b; simp
      · simp [a, b, show ¬ v < 257 by omega, Nat.mul_comm]
  have split : mass (fun v => if v = 256 then 0 else fl v) 286 =
      mass (fun v => if v < 256 then fl v else 0) 286 + mass (fun v => if v < 257 then 0 else fl v) 286 := by
    rw [← mass_add]
    apply mass_congr
    intro v _
    by_cases a : v < 256
    · simp [a, show v ≠ 256 by omega, show v < 257 by omega]
    · by_cases b : v = 256
      · subst b; simp
      · simp [a, b, show ¬ v < 257 by omega]
  have fdx : mass (fun v => fd v * 5) 30 = 5 * mass fd 30 := by rw [mass_mul_right, Nat.mul_comm]
  have dx : mass (fun v => fd v * 50757632) 30 = 50757632 * mass fd 30 := by
    rw [mass_mul_right, Nat.mul_comm]
  rw [literal_share_sum_none, rates] at sumL
  rw [distance_share_sum_none] at sumD
  rw [split] at symbols
  have muL := mass_mul_left (fun v => fl v * staticLen v) 286 12779520
  have cnt0 : mass (fun v => isUsed (ll v)) 286 ≤ 286 := by
    have := mass_mono (n := 286) (f := fun v => isUsed (ll v)) (g := fun _ => 1)
