  · have q := entry_distance11 (dl v) (fd v) 0 hx used nodummy rfl
    simp only [distanceAllow, Nat.add_zero] at q ⊢; omega
  · have q := entry_distance12 (dl v) (fd v) 0 hx used nodummy rfl
    simp only [distanceAllow, Nat.add_zero] at q ⊢; omega
  · have q := entry_distance13 (dl v) (fd v) 0 hx used nodummy rfl
