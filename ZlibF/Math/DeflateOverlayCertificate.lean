theorem distance_entry (dl fd : Nat → Nat) (v : Nat) (hv : v < 30) (hx : dl v ≤ 15)
    (used : fd v ≠ 0 → 1 ≤ dl v ∧ fd v * fib (dl v + 1) + fib (dl v) ≤ 258)
    (dummy : dl v ≠ 0 → fd v = 0 → v ≤ 2) :
    262144 * (entryCost (dl v) + fd v * distanceExcess v (dl v)) ≤
      85 * kraftTerm (dl v) + distanceShare v + fd v * 360448 := by
  simp only [distanceExcess, distanceShare]
  by_cases low : v ≤ 2
  · have e0 : distanceExtra v = 0 := by
      rcases v with _ | _ | _ | v <;> first | rfl | omega
    rw [e0]
    have q := entry_distance0 (dl v) (fd v) (if v ≤ 2 then 1056683 else 0) hx used
      (fun x0 f0 => by simp [dummy x0 f0]) (fun _ => by by_cases s : v ≤ 2 <;> simp [s])
    simp only [distanceAllow] at q ⊢
    omega
  have nodummy : dl v ≠ 0 → fd v ≠ 0 := fun x0 f0 => by have := dummy x0 f0; omega
  simp only [low, ite_false, Nat.add_zero]
  by_cases three : v = 3
  · subst three
    have q := entry_distance0 (dl 3) (fd 3) 0 hx used (fun x0 f0 => absurd f0 (nodummy x0)) (fun _ => Or.inl rfl)
    simp only [distanceAllow, distanceExtra, Nat.add_zero] at q ⊢; omega
  have pos := distanceExtra_pos v (by omega) hv
  have le13 := distanceExtra_le v
  generalize distanceExtra v = e at pos le13 ⊢
  rcases e with _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | e
  · omega
  · have q := entry_distance1 (dl v) (fd v) 0 hx used nodummy rfl
    simp only [distanceAllow, Nat.add_zero] at q ⊢; omega
  · have q := entry_distance2 (dl v) (fd v) 0 hx used nodummy rfl
    simp only [distanceAllow, Nat.add_zero] at q ⊢; omega
  · have q := entry_distance3 (dl v) (fd v) 0 hx used nodummy rfl
    simp only [distanceAllow, Nat.add_zero] at q ⊢; omega
  · have q := entry_distance4 (dl v) (fd v) 0 hx used nodummy rfl
    simp only [distanceAllow, Nat.add_zero] at q ⊢; omega
  · have q := entry_distance5 (dl v) (fd v) 0 hx used nodummy rfl
    simp only [distanceAllow, Nat.add_zero] at q ⊢; omega
  · have q := entry_distance6 (dl v) (fd v) 0 hx used nodummy rfl
    simp only [distanceAllow, Nat.add_zero] at q ⊢; omega
  · have q := entry_distance7 (dl v) (fd v) 0 hx used nodummy rfl
    simp only [distanceAllow, Nat.add_zero] at q ⊢; omega
  · have q := entry_distance8 (dl v) (fd v) 0 hx used nodummy rfl
    simp only [distanceAllow, Nat.add_zero] at q ⊢; omega
  · have q := entry_distance9 (dl v) (fd v) 0 hx used nodummy rfl
    simp only [distanceAllow, Nat.add_zero] at q ⊢; omega
  · have q := entry_distance10 (dl v) (fd v) 0 hx used nodummy rfl
