theorem mass_split (f : Nat → Nat) (a b : Nat) :
    mass f (a + b) = mass f a + mass (fun k => f (a + k)) b := by
  induction b with
  | zero => rfl
  | succ b ih =>
    show mass f (a + b) + f (a + b) = mass f a + (mass (fun k => f (a + k)) b + f (a + b))
    rw [ih]; omega

theorem mass_const (c n : Nat) : mass (fun _ => c) n = n * c := by
  induction n with
  | zero => simp [mass]
  | succ n ih => simp only [mass, ih, Nat.succ_mul]

theorem lengthExtra_le (c : Nat) : lengthExtra c ≤ 5 := by
  unfold lengthExtra; split <;> omega

theorem distanceExtra_le (c : Nat) : distanceExtra c ≤ 13 := by
  unfold distanceExtra; split <;> omega

theorem distanceExtra_pos (c : Nat) (big : 4 ≤ c) (lt : c < 30) : distanceExtra c ≠ 0 := by
  rcases c with _ | _ | _ | _ | c
  all_goals try omega
  rcases c with _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | c
  all_goals first | omega | (simp only [distanceExtra]; omega)

theorem literal_share_sum : mass literalAllow 286 = 232530925 := by
  rw [show 286 = 3 + 283 from rfl, mass_split, show 283 = 253 + 30 from rfl, mass_split,
    show 30 = 1 + 29 from rfl, mass_split]
  have mid : mass (fun k => literalAllow (3 + k)) 253 = 253 * literalAllow 3 := by
    rw [← mass_const]
    apply mass_congr
    intro k lt
    simp only [literalAllow, show 3 + k < 256 by omega, show ¬ (3 + k ≤ 2) by omega,
      show (3 : Nat) < 256 by omega, show ¬ ((3 : Nat) ≤ 2) by omega, ite_true, ite_false]
  rw [mid]
  simp (config := { decide := true }) only [literalAllow, lengthAllow, lengthExtra, Nat.reduceAdd,
    Nat.reduceSub, Nat.reduceMul, ite_true, ite_false]

theorem distance_share_sum : mass distanceShare 30 = 93684833 := by
  simp (config := { decide := true }) only [mass, distanceShare, distanceAllow, distanceExtra,
    Nat.reduceAdd, Nat.reduceMul, ite_true, ite_false]

/-- Each literal/length entry costs at most its share. -/
theorem literal_entry (ll fl : Nat → Nat) (v : Nat) (hv : v < 286) (hx : ll v ≤ 15)
    (used : fl v ≠ 0 → 1 ≤ ll v ∧ fl v * fib (ll v + 1) + fib (ll v) ≤ 258)
    (dummy : ll v ≠ 0 → fl v = 0 → v ≤ 2) (eob : fl 256 = 1) :
    262144 * (entryCost (ll v) + fl v * literalExcess v (ll v)) ≤
      129 * kraftTerm (ll v) + literalAllow v + fl v * literalRate v := by
  by_cases lit : v < 256
  · have ex : literalExcess v (ll v) = 0 := by simp [literalExcess, show v < 257 by omega]
    rw [ex, Nat.mul_zero, Nat.add_zero]
    simp only [literalAllow, literalRate, lit, ite_true]
    have e := entry_literal (ll v) (fl v) (if v ≤ 2 then 1310591 else 0) hx used
      (fun x0 f0 => by simp [dummy x0 f0]) (fun _ => by by_cases s : v ≤ 2 <;> simp [s])
    omega
  by_cases endc : v = 256
  · subst endc
    have ex : literalExcess 256 (ll 256) = 0 := by simp [literalExcess]
    rw [ex, Nat.mul_zero, Nat.add_zero, eob]
    simp (config := { decide := true }) only [literalAllow, literalRate, ite_true, ite_false]
    have u := used (by omega)
    rw [eob] at u
    have e := entry_end (ll 256) 1 0 hx ⟨rfl, u⟩ rfl
    omega
  have ex : literalExcess v (ll v) = ll v + lengthExtra (v - 257) - 9 := by
    simp [literalExcess, show ¬ v < 257 by omega]
  rw [ex]
  simp only [literalAllow, literalRate, lit, endc, ite_false, show ¬ v ≤ 2 by omega, Nat.add_zero]
  have nodummy : ll v ≠ 0 → fl v ≠ 0 := fun x0 f0 => by have := dummy x0 f0; omega
  have le5 := lengthExtra_le (v - 257)
  generalize lengthExtra (v - 257) = e at le5 ⊢
  rcases e with _ | _ | _ | _ | _ | _ | e
  · have q := entry_length0 (ll v) (fl v) 0 hx used nodummy rfl
    simp only [lengthAllow, Nat.add_zero] at q ⊢; omega
  · have q := entry_length1 (ll v) (fl v) 0 hx used nodummy rfl
    simp only [lengthAllow, Nat.add_zero] at q ⊢; omega
  · have q := entry_length2 (ll v) (fl v) 0 hx used nodummy rfl
    simp only [lengthAllow, Nat.add_zero] at q ⊢; omega
  · have q := entry_length3 (ll v) (fl v) 0 hx used nodummy rfl
    simp only [lengthAllow, Nat.add_zero] at q ⊢; omega
  · have q := entry_length4 (ll v) (fl v) 0 hx used nodummy rfl
    simp only [lengthAllow, Nat.add_zero] at q ⊢; omega
  · have q := entry_length5 (ll v) (fl v) 0 hx used nodummy rfl
    simp only [lengthAllow, Nat.add_zero] at q ⊢; omega
  · omega

