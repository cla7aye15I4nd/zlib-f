/-- **The memLevel 2 certificate.** -/
theorem certificate (ll fl dl fd : Nat → Nat)
    (lenL : ∀ v, v < 286 → ll v ≤ 15) (lenD : ∀ v, v < 30 → dl v ≤ 15)
    (kraftL : mass (fun v => kraftTerm (ll v)) 286 ≤ 2 ^ 15)
    (kraftD : mass (fun v => kraftTerm (dl v)) 30 ≤ 2 ^ 15)
    (usedL : ∀ v, v < 286 → fl v ≠ 0 → 1 ≤ ll v ∧ fl v * fib (ll v + 1) + fib (ll v) ≤ 258)
    (usedD : ∀ v, v < 30 → fd v ≠ 0 → 1 ≤ dl v ∧ fd v * fib (dl v + 1) + fib (dl v) ≤ 258)
    (dummyL : ∀ v, v < 286 → ll v ≠ 0 → fl v = 0 → v ≤ 2)
    (dummyD : ∀ v, v < 30 → dl v ≠ 0 → fd v = 0 → v ≤ 2)
    (eob : fl 256 = 1)
    (symbols : mass (fun v => if v = 256 then 0 else fl v) 286 ≤ 255)
    (balance : mass (fun v => if v < 257 then 0 else fl v) 286 = mass fd 30) :
    71 + mass (fun v => entryCost (ll v)) 286 + mass (fun v => entryCost (dl v)) 30 +
      mass (fun v => fl v * literalExcess v (ll v)) 286 +
      mass (fun v => fd v * distanceExcess v (dl v)) 30 ≤ 1852 := by
  -- every entry within its share, summed
  have sumL : mass (fun v => 262144 * (entryCost (ll v) + fl v * literalExcess v (ll v))) 286 ≤
      mass (fun v => 129 * kraftTerm (ll v) + literalAllow v + fl v * literalRate v) 286 :=
    mass_mono fun v hv => literal_entry ll fl v hv (lenL v hv) (usedL v hv) (dummyL v hv) eob
  have sumD : mass (fun v => 262144 * (entryCost (dl v) + fd v * distanceExcess v (dl v))) 30 ≤
      mass (fun v => 85 * kraftTerm (dl v) + distanceShare v + fd v * 360448) 30 :=
    mass_mono fun v hv => distance_entry dl fd v hv (lenD v hv) (usedD v hv) (dummyD v hv)
  rw [mass_mul_left, mass_add, mass_add, mass_add, mass_mul_left] at sumL sumD
  rw [mass_mul_right] at sumD
  -- the frequency shares: symbols at mu, length codes at mu + nu, distance codes at -nu
  have rates : mass (fun v => fl v * literalRate v) 286 =
      524288 * mass (fun v => if v < 256 then fl v else 0) 286 +
        163840 * mass (fun v => if v < 257 then 0 else fl v) 286 := by
    rw [← mass_mul_left, ← mass_mul_left, ← mass_add]
    apply mass_congr
    intro v _
    simp only [literalRate]
    by_cases a : v < 256
    · simp [a, show v < 257 by omega, Nat.mul_comm]
    · by_cases b : v = 256
      · subst b; simp
      · simp [a, b, show ¬ v < 257 by omega, Nat.mul_comm]
  have split : mass (fun v => if v = 256 then 0 else fl v) 286 =
      mass (fun v => if v < 256 then fl v else 0) 286 + mass (fun v => if v < 257 then 0 else fl v) 286 := by
    rw [← mass_add]
    apply mass_congr
    intro v _
    by_cases a : v < 256
    · simp [a, show v ≠ 256 by omega, show v < 257 by omega]
    · by_cases b : v = 256
      · subst b; simp
      · simp [a, b, show ¬ v < 257 by omega]
  rw [literal_share_sum] at sumL
  rw [distance_share_sum] at sumD
  rw [rates] at sumL
  rw [split] at symbols
  omega

#print axioms certificate

end ZlibF.Math.DeflateOverlayCertificate
