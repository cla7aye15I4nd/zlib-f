/-- The share of literal/length entry `v` (scaled), dummies included. -/
def literalAllow (v : Nat) : Nat :=
  (if v < 256 then 524288 else if v = 256 then 1046528 else lengthAllow (lengthExtra (v - 257))) +
    (if v ≤ 2 then 1310591 else 0)

/-- The share of distance entry `v` (scaled), dummies included. -/
def distanceShare (v : Nat) : Nat := distanceAllow (distanceExtra v) + (if v ≤ 2 then 1056683 else 0)

/-- The frequency multiplier of literal/length entry `v` (scaled). -/
def literalRate (v : Nat) : Nat := if v < 256 then 524288 else if v = 256 then 0 else 163840

