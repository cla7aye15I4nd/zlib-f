/-! ## The heap -/

/-- The heap: one table per kind of object. A table maps a block number to the object, or to `none` when the
block is free or was never allocated. Block numbers are never reused. -/
structure Heap where
  /-- byte blocks (`unsigned char` arrays: buffers, windows, strings) -/
  bytes : Tbl (Option (Array UInt8))
  /-- blocks of 16-bit words (`head`, `prev`) -/
  words : Tbl (Option (Array UInt16))
  /-- the byte blocks that are read-only (string literals, `const` buffers) -/
  ro : Tbl Bool
  /-- the table of `struct z_stream` -/
  streams : Tbl (Option ZStream)
  /-- the table of `struct gz_header` -/
  gzheaders : Tbl (Option GzHeader)
  /-- the table of `struct deflate_state` -/
  dstates : Tbl (Option DeflateState)
  /-- the table of `struct inflate_state` -/
  istates : Tbl (Option InflateState)
  /-- the table of `struct gz_state` -/
  gzstates : Tbl (Option GzState)
  /-- the static tables -/
  static : Statics
  /-- the next unused block number -/
  nextBlk : Nat
  /-- the number of allocation calls so far -/
  nalloc : Nat
  /-- the failure oracle: allocation call number `n` succeeds iff `allocOk n` -/
  allocOk : Nat → Bool
  /-- the content of fresh memory: position `i` of the memory returned by allocation call number `n` -/
  garbage : Nat → Nat → UInt64

/-- The heap with nothing allocated. -/
def Heap.empty : Heap where
  bytes := Tbl.empty
  words := Tbl.empty
  ro := Tbl.empty
  streams := Tbl.empty
  gzheaders := Tbl.empty
  dstates := Tbl.empty
  istates := Tbl.empty
  gzstates := Tbl.empty
  static := default
  nextBlk := 0
  nalloc := 0
  allocOk := fun _ => true
  garbage := fun _ _ => 0

instance : Inhabited Heap := ⟨Heap.empty⟩

/-- The block number `b` is in use: some table holds an object under it. -/
def Heap.live (h : Heap) (b : Nat) : Prop :=
  h.bytes b ≠ none ∨ h.words b ≠ none ∨ h.streams b ≠ none ∨ h.gzheaders b ≠ none ∨ h.dstates b ≠ none ∨ h.istates b ≠ none ∨ h.gzstates b ≠ none

/-- Every block number from `nextBlk` on is unused. -/
def Fresh (h : Heap) : Prop := ∀ b, h.nextBlk ≤ b → ¬ h.live b

/-- The heap with nothing allocated is `Fresh`. -/
theorem Heap.empty_fresh : Fresh Heap.empty := by
  intro b _ hl
  simp [Heap.live, Heap.empty] at hl

/-- The decidable form of `Heap.live`: some table holds an object under the block number `b`. Every allocation
primitive tests it for the number it is about to use and faults if it is set, so an allocation never overwrites a
live object. -/
def Heap.slotUsed (h : Heap) (b : Nat) : Bool :=
  (h.bytes b).isSome || (h.words b).isSome || (h.streams b).isSome || (h.gzheaders b).isSome || (h.dstates b).isSome || (h.istates b).isSome || (h.gzstates b).isSome

theorem Heap.slotUsed_eq_false {h : Heap} {b : Nat} : h.slotUsed b = false ↔ ¬ h.live b := by
  simp [Heap.slotUsed, Heap.live, and_assoc]

/-- In a `Fresh` heap the number the next allocation takes is unused. -/
theorem Fresh.slotUsed_next {h : Heap} (hF : Fresh h) : h.slotUsed h.nextBlk = false :=
  Heap.slotUsed_eq_false.2 (hF h.nextBlk (Nat.le_refl _))

/-- Discharges the hypothesis `h.slotUsed h.nextBlk = false` of the allocation rules (`allocB_some`, ...) from a
hypothesis of the context: itself, or `Fresh h`. -/
macro "fresh_slot" : tactic => `(tactic| first | assumption | exact Fresh.slotUsed_next ‹_›)

/-- The live blocks are exactly those of `S`: the ownership statement, and with it the absence of leaks. -/
def Heap.Owns (h : Heap) (S : Nat → Prop) : Prop := ∀ b, h.live b ↔ S b

theorem Heap.not_live {h : Heap} {b : Nat} :
    ¬ h.live b ↔ (h.bytes b = none ∧ h.words b = none ∧ h.streams b = none ∧ h.gzheaders b = none ∧ h.dstates b = none ∧ h.istates b = none ∧ h.gzstates b = none) := by
  simp [Heap.live]

/-- A heap whose tables agree with those of a `Fresh` heap from its own `nextBlk` on, and whose `nextBlk` is not
smaller, is `Fresh` too. -/
theorem Fresh.mono {h h' : Heap} (hF : Fresh h) (hnb : h.nextBlk ≤ h'.nextBlk)
    (ht : ∀ x, h'.nextBlk ≤ x → (h'.bytes x = h.bytes x ∧ h'.words x = h.words x ∧ h'.streams x = h.streams x ∧ h'.gzheaders x = h.gzheaders x ∧ h'.dstates x = h.dstates x ∧ h'.istates x = h.istates x ∧ h'.gzstates x = h.gzstates x)) : Fresh h' := by
  intro x hx hl
  obtain ⟨e0, e1, e2, e3, e4, e5, e6⟩ := ht x hx
  apply hF x (Nat.le_trans hnb hx)
  unfold Heap.live at hl ⊢
  rw [e0, e1, e2, e3, e4, e5, e6] at hl
  exact hl

/-- A live block number is below `nextBlk`. -/
theorem Fresh.lt {h : Heap} (hF : Fresh h) {b : Nat} (hl : h.live b) : b < h.nextBlk := by
  rcases Nat.lt_or_ge b h.nextBlk with hb | hb
  · exact hb
  · exact absurd hl (hF b hb)

theorem Fresh.bytes {h : Heap} (hF : Fresh h) {b : Nat} (hb : h.nextBlk ≤ b) : h.bytes b = none := by
  cases hn : h.bytes b with
  | none => rfl
  | some a => exact absurd (Or.inl (by rw [hn]; simp)) (hF b hb)

/-! ## Fresh memory of every record (`ZALLOC` does not initialise)

Integers are arbitrary (the values `g i`). Pointers are NULL: this is a documented gap, not C: a pointer read from
uninitialised memory is indeterminate in C, and here it is a valid null (see `docs/trusted-base.md`, item 2).
`K.zeroed` is the same record with every integer 0: the content after `memset(p, 0, sizeof *p)`, where NULL
is the right value of every pointer. -/

