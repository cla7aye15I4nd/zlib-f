/-- The static tables have the lengths of the C declaration. Their content is a separate obligation of the
translation that fixes them (see `docs/runtime-schema.md`). -/
def Statics.WellFormed (v : Statics) : Prop := v.dist_code.size = 512 ∧ v.length_code.size = 256 ∧ v.base_dist.size = 30 ∧ v.base_length.size = 29 ∧ v.crc_table.size = 256 ∧ v.static_dtree.size = 30 ∧ v.static_ltree.size = 288 ∧ v.x2n_table.size = 32 ∧ v.lenfix.size = 512 ∧ v.distfix.size = 32 ∧ v.extra_lbits.size = 29 ∧ v.extra_dbits.size = 30 ∧ v.extra_blbits.size = 19

/-- The records and the static tables of the heap are well-formed. -/
def Heap.WellFormed (h : Heap) : Prop := h.RecordsWellFormed ∧ h.static.WellFormed

/-! ## Reading and writing arrays and structs through a reference -/

instance : Space Heap IRef Int32 where
  get h r := match r with
    | .dstate_heap id => (h.dstates id).map (·.heap)
    | .st_base_dist => some h.static.base_dist
    | .st_base_length => some h.static.base_length
    | .st_extra_lbits => some h.static.extra_lbits
    | .st_extra_dbits => some h.static.extra_dbits
    | .st_extra_blbits => some h.static.extra_blbits
  put h r a := match r with
    | .dstate_heap id => (match h.dstates id with | some s => { h with dstates := upd h.dstates id (some { s with heap := a }) } | none => h)
    | .st_base_dist => h
    | .st_base_length => h
    | .st_extra_lbits => h
    | .st_extra_dbits => h
    | .st_extra_blbits => h
  ro _ r := match r with
    | .dstate_heap _ => false
    | .st_base_dist => true
    | .st_base_length => true
    | .st_extra_lbits => true
    | .st_extra_dbits => true
    | .st_extra_blbits => true
  modify h r f := match r with
    | .dstate_heap id => { h with dstates := h.dstates.modify id (Option.map (fun s => let l := s.heap; let s := { s with heap := #[] }; { s with heap := f l })) }
    | .st_base_dist => h
    | .st_base_length => h
    | .st_extra_lbits => h
    | .st_extra_dbits => h
    | .st_extra_blbits => h
  modify_eq := by
    intro h r a f hg
    cases r with
    | dstate_heap id =>
      dsimp only at hg ⊢
      cases hs : h.dstates id with
      | none => simp [hs] at hg
      | some s =>
        have ha : s.heap = a := by simpa [hs] using hg
        subst ha
        have hm := Tbl.modify_opt h.dstates id (fun s => { s with heap := f s.heap }) s hs
        simp only [hs]
        exact congrArg (fun t => ({ h with dstates := t } : Heap)) hm
    | st_base_dist =>
      dsimp only at hg ⊢
      try rfl
    | st_base_length =>
      dsimp only at hg ⊢
      try rfl
    | st_extra_lbits =>
      dsimp only at hg ⊢
      try rfl
    | st_extra_dbits =>
      dsimp only at hg ⊢
      try rfl
    | st_extra_blbits =>
      dsimp only at hg ⊢
      try rfl

theorem IRef.get_dstate_heap {h : Heap} {id : Nat} {s : DeflateState} (e : h.dstates id = some s) :
    Space.get h (IRef.dstate_heap id) = some s.heap := by simp [Space.get, e]
theorem IRef.put_dstate_heap {h : Heap} {id : Nat} {s : DeflateState} (e : h.dstates id = some s) (a : Array Int32) :
    Space.put h (IRef.dstate_heap id) a = { h with dstates := upd h.dstates id (some { s with heap := a }) } := by
  simp [Space.put, e]
/-- Storing into an array field of a well-formed record, with an array of the same length, keeps every record
well-formed. -/
theorem IRef.put_dstate_heap_wf {h : Heap} (hw : h.RecordsWellFormed) {id : Nat} {s : DeflateState} (e : h.dstates id = some s)
    {a : Array Int32} (ha : a.size = s.heap.size) : (Space.put h (IRef.dstate_heap id) a).RecordsWellFormed := by
  rw [IRef.put_dstate_heap e a]
  have hs : s.WellFormed := by
    unfold Heap.RecordsWellFormed at hw
    obtain ⟨t0, t1, t2, t3, t4⟩ := hw
    exact t2 id s e
  apply Heap.RecordsWellFormed.set_dstates hw
  simpa [DeflateState.WellFormed, ha] using hs
@[simp] theorem IRef.ro_dstate_heap (h : Heap) (id : Nat) : Space.ro h (IRef.dstate_heap id) = false := rfl
@[simp] theorem IRef.get_st_base_dist (h : Heap) : Space.get h IRef.st_base_dist = some h.static.base_dist := rfl
@[simp] theorem IRef.ro_st_base_dist (h : Heap) : Space.ro h IRef.st_base_dist = true := rfl
@[simp] theorem IRef.get_st_base_length (h : Heap) : Space.get h IRef.st_base_length = some h.static.base_length := rfl
@[simp] theorem IRef.ro_st_base_length (h : Heap) : Space.ro h IRef.st_base_length = true := rfl
@[simp] theorem IRef.get_st_extra_lbits (h : Heap) : Space.get h IRef.st_extra_lbits = some h.static.extra_lbits := rfl
@[simp] theorem IRef.ro_st_extra_lbits (h : Heap) : Space.ro h IRef.st_extra_lbits = true := rfl
@[simp] theorem IRef.get_st_extra_dbits (h : Heap) : Space.get h IRef.st_extra_dbits = some h.static.extra_dbits := rfl
@[simp] theorem IRef.ro_st_extra_dbits (h : Heap) : Space.ro h IRef.st_extra_dbits = true := rfl
@[simp] theorem IRef.get_st_extra_blbits (h : Heap) : Space.get h IRef.st_extra_blbits = some h.static.extra_blbits := rfl
@[simp] theorem IRef.ro_st_extra_blbits (h : Heap) : Space.ro h IRef.st_extra_blbits = true := rfl
instance : Space Heap WRef UInt16 where
  get h r := match r with
    | .blk b => h.words b
    | .dstate_bl_count id => (h.dstates id).map (·.bl_count)
    | .istate_lens id => (h.istates id).map (·.lens)
    | .istate_work id => (h.istates id).map (·.work)
  put h r a := match r with
    | .blk b => { h with words := upd h.words b (some a) }
    | .dstate_bl_count id => (match h.dstates id with | some s => { h with dstates := upd h.dstates id (some { s with bl_count := a }) } | none => h)
    | .istate_lens id => (match h.istates id with | some s => { h with istates := upd h.istates id (some { s with lens := a }) } | none => h)
    | .istate_work id => (match h.istates id with | some s => { h with istates := upd h.istates id (some { s with work := a }) } | none => h)
  ro _ r := match r with
    | .blk _ => false
    | .dstate_bl_count _ => false
    | .istate_lens _ => false
    | .istate_work _ => false
  modify h r f := match r with
    | .blk b => { h with words := h.words.modify b (Option.map f) }
    | .dstate_bl_count id => { h with dstates := h.dstates.modify id (Option.map (fun s => let l := s.bl_count; let s := { s with bl_count := #[] }; { s with bl_count := f l })) }
    | .istate_lens id => { h with istates := h.istates.modify id (Option.map (fun s => let l := s.lens; let s := { s with lens := #[] }; { s with lens := f l })) }
    | .istate_work id => { h with istates := h.istates.modify id (Option.map (fun s => let l := s.work; let s := { s with work := #[] }; { s with work := f l })) }
  modify_eq := by
    intro h r a f hg
    cases r with
    | blk b =>
      dsimp only at hg ⊢
      rw [Tbl.modify_opt _ _ _ _ hg]
    | dstate_bl_count id =>
      dsimp only at hg ⊢
      cases hs : h.dstates id with
      | none => simp [hs] at hg
      | some s =>
        have ha : s.bl_count = a := by simpa [hs] using hg
        subst ha
        have hm := Tbl.modify_opt h.dstates id (fun s => { s with bl_count := f s.bl_count }) s hs
        simp only [hs]
        exact congrArg (fun t => ({ h with dstates := t } : Heap)) hm
    | istate_lens id =>
      dsimp only at hg ⊢
      cases hs : h.istates id with
      | none => simp [hs] at hg
      | some s =>
        have ha : s.lens = a := by simpa [hs] using hg
        subst ha
        have hm := Tbl.modify_opt h.istates id (fun s => { s with lens := f s.lens }) s hs
        simp only [hs]
        exact congrArg (fun t => ({ h with istates := t } : Heap)) hm
    | istate_work id =>
      dsimp only at hg ⊢
      cases hs : h.istates id with
      | none => simp [hs] at hg
      | some s =>
        have ha : s.work = a := by simpa [hs] using hg
        subst ha
        have hm := Tbl.modify_opt h.istates id (fun s => { s with work := f s.work }) s hs
        simp only [hs]
        exact congrArg (fun t => ({ h with istates := t } : Heap)) hm

