instance : Space Heap URef UInt32 where
  get h r := match r with
    | .st_crc_table => some h.static.crc_table
    | .st_x2n_table => some h.static.x2n_table
  put h r _ := match r with
    | .st_crc_table => h
    | .st_x2n_table => h
  ro _ r := match r with
    | .st_crc_table => true
    | .st_x2n_table => true
  modify h r _ := match r with
    | .st_crc_table => h
    | .st_x2n_table => h
  modify_eq := by
    intro h r a f hg
    cases r with
    | st_crc_table =>
      dsimp only at hg ⊢
      try rfl
    | st_x2n_table =>
      dsimp only at hg ⊢
      try rfl

@[simp] theorem URef.get_st_crc_table (h : Heap) : Space.get h URef.st_crc_table = some h.static.crc_table := rfl
@[simp] theorem URef.ro_st_crc_table (h : Heap) : Space.ro h URef.st_crc_table = true := rfl
@[simp] theorem URef.get_st_x2n_table (h : Heap) : Space.get h URef.st_x2n_table = some h.static.x2n_table := rfl
@[simp] theorem URef.ro_st_x2n_table (h : Heap) : Space.ro h URef.st_x2n_table = true := rfl
instance : Space Heap BRef UInt8 where
  get h r := match r with
    | .blk b => h.bytes b
    | .str i => (strTable[i]?).map strBytes
    | .dstate_depth id => (h.dstates id).map (·.depth)
    | .st_dist_code => some h.static.dist_code
    | .st_length_code => some h.static.length_code
  put h r a := match r with
    | .blk b => { h with bytes := upd h.bytes b (some a) }
    | .str _ => h
    | .dstate_depth id => (match h.dstates id with | some s => { h with dstates := upd h.dstates id (some { s with depth := a }) } | none => h)
    | .st_dist_code => h
    | .st_length_code => h
  ro h r := match r with
    | .blk b => h.ro b
    | .str _ => true
    | .dstate_depth _ => false
    | .st_dist_code => true
    | .st_length_code => true
  modify h r f := match r with
    | .blk b => { h with bytes := h.bytes.modify b (Option.map f) }
    | .str _ => h
    | .dstate_depth id => { h with dstates := h.dstates.modify id (Option.map (fun s => let l := s.depth; let s := { s with depth := #[] }; { s with depth := f l })) }
    | .st_dist_code => h
    | .st_length_code => h
  modify_eq := by
    intro h r a f hg
    cases r with
    | blk b =>
      dsimp only at hg ⊢
      rw [Tbl.modify_opt _ _ _ _ hg]
    | str i =>
      dsimp only at hg ⊢
      try rfl
    | dstate_depth id =>
      dsimp only at hg ⊢
      cases hs : h.dstates id with
      | none => simp [hs] at hg
      | some s =>
        have ha : s.depth = a := by simpa [hs] using hg
        subst ha
        have hm := Tbl.modify_opt h.dstates id (fun s => { s with depth := f s.depth }) s hs
        simp only [hs]
        exact congrArg (fun t => ({ h with dstates := t } : Heap)) hm
    | st_dist_code =>
      dsimp only at hg ⊢
      try rfl
    | st_length_code =>
      dsimp only at hg ⊢
      try rfl

