/-- The record a reference denotes, if it is live. -/
def ZStreamRef.get (h : Heap) : ZStreamRef → Option ZStream
  | .tab i => h.streams i
  | .in_gzstate_strm i => (h.gzstates i).map (·.strm)

/-- The heap after replacing the record a reference denotes (unchanged if it is not live: a freed record is not
brought back). -/
def ZStreamRef.put (h : Heap) : ZStreamRef → ZStream → Heap
  | .tab i, v => (match h.streams i with
    | some _ => { h with streams := upd h.streams i (some v) }
    | none => h)
  | .in_gzstate_strm i, v => (match h.gzstates i with
    | some s => { h with gzstates := upd h.gzstates i (some { s with strm := v }) }
    | none => h)

theorem ZStreamRef.put_tab {h : Heap} {i : Nat} {v : ZStream} (e : h.streams i = some v) (v' : ZStream) :
    (ZStreamRef.tab i).put h v' = { h with streams := upd h.streams i (some v') } := by simp [ZStreamRef.put, e]

