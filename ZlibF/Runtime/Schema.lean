  get h r := match r with
    | .dstate_dyn_ltree id => (h.dstates id).map (·.dyn_ltree)
    | .dstate_dyn_dtree id => (h.dstates id).map (·.dyn_dtree)
    | .dstate_bl_tree id => (h.dstates id).map (·.bl_tree)
    | .st_static_dtree => some h.static.static_dtree
    | .st_static_ltree => some h.static.static_ltree
  put h r a := match r with
    | .dstate_dyn_ltree id => (match h.dstates id with | some s => { h with dstates := upd h.dstates id (some { s with dyn_ltree := a }) } | none => h)
    | .dstate_dyn_dtree id => (match h.dstates id with | some s => { h with dstates := upd h.dstates id (some { s with dyn_dtree := a }) } | none => h)
    | .dstate_bl_tree id => (match h.dstates id with | some s => { h with dstates := upd h.dstates id (some { s with bl_tree := a }) } | none => h)
    | .st_static_dtree => h
    | .st_static_ltree => h
  ro _ r := match r with
    | .dstate_dyn_ltree _ => false
    | .dstate_dyn_dtree _ => false
    | .dstate_bl_tree _ => false
    | .st_static_dtree => true
    | .st_static_ltree => true
  modify h r f := match r with
    | .dstate_dyn_ltree id => { h with dstates := h.dstates.modify id (Option.map (fun s => let l := s.dyn_ltree; let s := { s with dyn_ltree := #[] }; { s with dyn_ltree := f l })) }
