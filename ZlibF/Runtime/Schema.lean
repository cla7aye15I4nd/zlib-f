/-- Every record in a table of the heap is well-formed. -/
def Heap.RecordsWellFormed (h : Heap) : Prop :=
  TableWF ZStream.WellFormed h.streams ∧ TableWF GzHeader.WellFormed h.gzheaders ∧ TableWF DeflateState.WellFormed h.dstates ∧ TableWF InflateState.WellFormed h.istates ∧ TableWF GzState.WellFormed h.gzstates

theorem Heap.empty_recordsWellFormed : Heap.empty.RecordsWellFormed := by
  refine ⟨fun _ _ hv => by simp [Heap.empty] at hv, fun _ _ hv => by simp [Heap.empty] at hv, fun _ _ hv => by simp [Heap.empty] at hv, fun _ _ hv => by simp [Heap.empty] at hv, fun _ _ hv => by simp [Heap.empty] at hv⟩

theorem Heap.RecordsWellFormed.set_streams {h : Heap} (hw : h.RecordsWellFormed) (i : Nat) {v : ZStream}
    (hv : v.WellFormed) : ({ h with streams := upd h.streams i (some v) } : Heap).RecordsWellFormed := by
  unfold Heap.RecordsWellFormed at hw ⊢
  obtain ⟨t0, t1, t2, t3, t4⟩ := hw
  exact ⟨(t0.set i hv), (t1), (t2), (t3), (t4)⟩

theorem Heap.RecordsWellFormed.clear_streams {h : Heap} (hw : h.RecordsWellFormed) (i : Nat) :
    ({ h with streams := upd h.streams i none } : Heap).RecordsWellFormed := by
  unfold Heap.RecordsWellFormed at hw ⊢
  obtain ⟨t0, t1, t2, t3, t4⟩ := hw
  exact ⟨(t0.clear i), (t1), (t2), (t3), (t4)⟩

