/-! ## Well-formed records

The array fields of a record are `Array`s of any length. The C declares the length. `K.WellFormed v` says that every
array field of `v` (and of the records nested in it) has exactly the declared length, so that `Ptr.load` of an
index inside the array is a read inside the C object. Nothing in the runtime checks it: `K.garbage` and `K.zeroed`
are well-formed, `Heap.RecordsWellFormed` says that every record of the heap is, and the lemmas
`Heap.RecordsWellFormed.set_*` and `clear_*` show that storing a well-formed record or freeing one keeps it. A
theorem about a record must state this as a hypothesis. -/

/-- Every entry of the table `t` satisfies `P`. -/
def TableWF {K : Type} (P : K → Prop) (t : Tbl (Option K)) : Prop := ∀ i v, t i = some v → P v

theorem TableWF.set {K : Type} {P : K → Prop} {t : Tbl (Option K)} (ht : TableWF P t) (i : Nat) {v : K} (hv : P v) :
    TableWF P (upd t i (some v)) := by
  intro j w hw
  by_cases hj : j = i
  · subst hj; simp at hw; subst hw; exact hv
  · rw [upd_ne _ _ _ _ hj] at hw; exact ht j w hw

theorem TableWF.clear {K : Type} {P : K → Prop} {t : Tbl (Option K)} (ht : TableWF P t) (i : Nat) :
    TableWF P (upd t i none) := by
  intro j w hw
  by_cases hj : j = i
  · subst hj; simp at hw
  · rw [upd_ne _ _ _ _ hj] at hw; exact ht j w hw

/-- The array fields of a `z_stream` have the lengths of the C declaration. -/
def ZStream.WellFormed (v : ZStream) : Prop := True

theorem ZStream.garbage_wf (g : Nat → UInt64) : (ZStream.garbage g).WellFormed := by
  simp [ZStream.garbage, ZStream.WellFormed]

theorem ZStream.zeroed_wf : ZStream.zeroed.WellFormed := ZStream.garbage_wf _

