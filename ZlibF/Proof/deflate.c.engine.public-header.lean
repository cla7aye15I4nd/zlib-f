import ZlibF.Proof.«deflate.c.engine.public-source»

/-! # Actual default zlib-header execution

The concrete header is generated by the source's level-six arithmetic.
Output is a distinct raw allocation. Both short-header return and the
continuation after a complete header are retained.
-/

namespace Zlib.Deflate.Engine.Proofs
open C Zlib.Deflate Zlib.Deflate.Spec Zlib.Deflate.Proofs
set_option autoImplicit false

def zlibHeaderBytes (buf : Array UInt8) : Array UInt8 := (buf.set! 0 120).set! 1 156

def zlibHeaderState (d : DeflateState) : DeflateState :=
  { d with pending := 2, status := BUSY_STATE }

def zlibHeaderReady (h : Heap) (r : ZStreamRef) (ds pb : Nat)
    (z : ZStream) (d : DeflateState) (buf : Array UInt8) : Heap :=
  setD (r.put { h with bytes := upd h.bytes pb (some (zlibHeaderBytes buf)) } { z with adler := 1 }) ds
    (zlibHeaderState d)

def zlibHeaderFlushed (h : Heap) (r : ZStreamRef) (ds pb ob oo : Nat)
    (z : ZStream) (d : DeflateState) (buf output : Array UInt8) : Heap :=
  let n := pendingLen 2 z.avail_out
  let ready := zlibHeaderReady h r ds pb z d buf
  let copied := { ready with bytes := upd ready.bytes ob (some (copyRange output (zlibHeaderBytes buf) oo 0 n.toNat)) }
  setD (r.put copied (pendingStream { z with adler := 1 } (.ref (.blk ob) (oo + n.toNat)) n)) ds
    (pendingState (zlibHeaderState d) (.ref (.blk pb) n.toNat) n)

/-- `int ZEXPORT deflate(z_streamp strm, int flush)` (zlib header fragment).
For the default wrapper, level and strategy, actual source arithmetic
writes 0x78,0x9c. Positive caller output copies its available prefix.
Raw output and pending storage are distinct. One output byte gives the
source's early Z_OK return; a full header reaches the given continuation.
This internal path does not restrict the public caller-buffer domain. -/
theorem public_default_header_run {h : Heap} {r : ZStreamRef} {ds pb ob oo : Nat}
    {z : ZStream} {d : DeflateState} {buf output : Array UInt8}
    (hz : r.get h = some z) (state : z.state = some (.deflate ds))
    (hd : h.dstates ds = some d) (status : d.status = INIT_STATE) (wrap : d.wrap = 1)
    (bits : d.bi_valid = 0) (level : d.level = 6) (strategy : d.strategy = 0)
    (window : d.w_bits = 15) (start : d.strstart = 0) (pending : d.pending = 0)
    (pendingPtr : d.pending_buf = .ref (.blk pb) 0) (cursor : d.pending_out = d.pending_buf)
    (get : h.bytes pb = some buf) (room : 2 ≤ buf.size) (rw : h.ro pb = false)
    (outPtr : z.next_out = .ref (.blk ob) oo) (outGet : h.bytes ob = some output)
    (outRw : h.ro ob = false) (separate : ob ≠ pb)
    (outBound : oo + z.avail_out.toNat ≤ output.size) (positive : z.avail_out ≠ 0)
    (next : M Int32) :
    let n := pendingLen 2 z.avail_out
    let after := zlibHeaderFlushed h r ds pb ob oo z d buf output
    publicZlibHeader (some r) (some (.tab ds)) next h =
      if 2 - n.toUInt64 != 0 then
        .ok (Z_OK, setD after ds { pendingState (zlibHeaderState d) (.ref (.blk pb) n.toNat) n with last_flush := -1 })
      else next after := by
  let n := pendingLen 2 z.avail_out
  let h1 := setD { h with bytes := upd h.bytes pb (some (zlibHeaderBytes buf)) } ds { d with pending := 2 }
  let ready := zlibHeaderReady h r ds pb z d buf
  let after := zlibHeaderFlushed h r ds pb ob oo z d buf output
  have put : putShortMSB (some (.tab ds)) 0x789c h = .ok ((), h1) := by
    simpa only [pending, show ((0 : UInt64).toNat) = 0 from rfl, Nat.zero_add, UInt64.zero_add,
      zlibHeaderBytes, h1, setD,
      show ((0x789c : UInt32) >>> 8).toUInt8 = 120 from by decide +kernel,
      show ((0x789c : UInt32) &&& 0xff).toUInt8 = 156 from by decide +kernel] using
      putShortMSB_ok (0x789c : UInt32) hd pendingPtr get rw (by simp only [pending]; change 1 < buf.size; omega)
        (by rw [pending]; decide)
  have z1 : r.get h1 = some z := by
    simpa only [h1, ZStreamRef.get_setD, stream_get_bytes] using hz
  have d1 : h1.dstates ds = some { d with pending := 2 } := by simp [h1]
  have writeBusy : wr (some (.tab ds)) (fun d => { d with status := BUSY_STATE })
      (r.put h1 { z with adler := 1 }) = .ok ((), ready) := by
    simp only [wrD_eq, ZStreamRef.put_dstates, d1]
    simp only [ready, zlibHeaderReady, h1, ZStreamRef.put_setD, setD_setD, zlibHeaderState]
  have zr : r.get ready = some { z with adler := 1 } := by
    simp only [ready, zlibHeaderReady, ZStreamRef.get_setD]
    apply ZStreamRef.get_put_same
    simpa only [stream_get_bytes] using hz
  have dr : ready.dstates ds = some (zlibHeaderState d) := by simp [ready, zlibHeaderReady]
  have len : n.toNat = min 2 z.avail_out.toNat := pendingLen_value 2 z.avail_out
  have nz : n ≠ 0 := by
    intro zero
    have pos : 0 < z.avail_out.toNat := by
      have ne : z.avail_out.toNat ≠ 0 := by
        intro empty
        exact positive (UInt32.toNat_inj.mp empty)
      omega
    have count := congrArg UInt32.toNat zero
    change n.toNat = 0 at count
    omega
  have flush : flush_pending (some r) ready = .ok ((), after) := by
    simpa only [zlibHeaderState, zlibHeaderFlushed, zlibHeaderReady, ready, after, n, Nat.zero_add,
      ZStreamRef.put_bytes, setD_bytes] using
      flush_pending_low_raw (pending := zlibHeaderBytes buf) (output := output) (po := 0) zr (by simpa using state) dr (by simp [zlibHeaderState, bits])
        outPtr (by simpa [zlibHeaderState, cursor] using pendingPtr)
        (by simpa [ready, zlibHeaderReady, upd_ne _ _ _ _ separate] using outGet)
        (by simp [ready, zlibHeaderReady]) (by simpa [ready, zlibHeaderReady] using outRw) separate
        outBound (by simpa [zlibHeaderBytes, zlibHeaderState] using room) nz
  have da : after.dstates ds = some (pendingState (zlibHeaderState d) (.ref (.blk pb) n.toNat) n) := by
    simp [after, zlibHeaderFlushed, n]
  unfold publicZlibHeader
  simp only [bind_app, pure_app, rdD_eq, hd, status, wrap]
  simp only [show (INIT_STATE == INIT_STATE) = true from rfl, show ((1 : Int32) == 0) = false from rfl,
    Bool.and_false, Bool.false_eq_true, ite_false, ite_true, bind_app, pure_app,
    rdD_eq, hd, status, ldDeflateState_tab hd, level, strategy, window, start]
  simp only [show ((0 : Int32) ≥ Z_HUFFMAN_ONLY) = False from by decide,
    show ((6 : Int32) < 2) = False from by decide, Bool.false_or,
    show ((6 : Int32) < 6) = False from by decide, show ((6 : Int32) == 6) = true from rfl,
    show ((0 : UInt32) != 0) = false from rfl, ite_false, ite_true, Bool.false_eq_true]
  simp only [decide_false, Bool.false_or, Bool.false_eq_true, ite_false]
  let raw : UInt32 := (((8 : UInt32) + (((15 : UInt32) - 8) <<< 4)) <<< 8) ||| ((2 : UInt32) <<< 6)
  have word : raw + ((31 : UInt32) - raw % 31) = 0x789c := by decide +kernel
  rw [word, bind_app, put]
  simp only [bind_app, pure_app, rdD_eq, d1, start, show ((0 : UInt32) != 0) = false from rfl, Bool.false_eq_true, ite_false,
    Zlib.Adler32.Proofs.adler32_null_init, pure_app, zwr_eq, z1, writeBusy, flush]
  simp only [bind_app, rdD_eq, da, pendingState, zlibHeaderState]
  split
  · simp only [wrD_eq, da, bind_app, setD_setD]
    rfl
  · rfl

end Zlib.Deflate.Engine.Proofs
