/-- Lift a heap computation without changing or hiding its outcome. -/
def heapCall {α : Type} (program : C.M α) : G α := fun fs h =>
  match program h with
  | .error fault => .error fault
  | .ok (value, after) => .ok ((value, fs), after)

/-- Execute the actual translated entry with every argument and result preserved. -/
def Call.execute : (call : Call) → G call.Result
  | .adler32 adler buf len => heapCall (Zlib.Adler32.adler32 adler buf len)
  | .adler32_combine adler1 adler2 len2 => heapCall (Zlib.Adler32.adler32_combine adler1 adler2 len2)
  | .adler32_combine64 adler1 adler2 len2 => heapCall (Zlib.Adler32.adler32_combine64 adler1 adler2 len2)
  | .adler32_z adler buf len => heapCall (Zlib.Adler32.adler32_z adler buf len)
  | .compress dest destLen source sourceLen => heapCall (Zlib.Compress.compress dest destLen source sourceLen)
  | .compress2 dest destLen source sourceLen level => heapCall (Zlib.Compress.compress2 dest destLen source sourceLen level)
  | .compress2_z dest destLen source sourceLen level => heapCall (Zlib.Compress.compress2_z dest destLen source sourceLen level)
  | .compressBound sourceLen => pure (Zlib.Compress.compressBound sourceLen)
